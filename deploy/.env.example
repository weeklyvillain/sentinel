# --- required ---
# DNS name of this (monitoring) server; Caddy gets a certificate for it.
SENTINEL_DOMAIN=sentinel.example.com
# Shared secret your collectors send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32   (comma-separate several to rotate)
INGEST_TOKEN=

# --- dashboard sign-in (GitHub App) ---
# Put the app's private key at deploy/secrets/github-app.pem
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
ALLOWED_USERS=
ALLOWED_ORG=

# --- AI (optional; falls back to a template) ---
ANTHROPIC_API_KEY=
# AI_PROVIDER=openai
# OPENAI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=llama3.1

# --- tuning (defaults shown) ---
# DOWN_AFTER=5m
# SETTLE_WINDOW=60s
# UPDATE_INTERVAL=30m
# MAX_ISSUES_PER_HOUR=10
# LOG_RETENTION=168h
# METRIC_RETENTION=168h
# GITHUB_LABELS=sentinel
