# The only setting Sentinel needs: the DNS name of this (monitoring) server.
# Caddy gets a certificate for it. Everything else is set up in the
# dashboard: open https://SENTINEL_DOMAIN and enter the setup code from
#   docker compose logs sentinel | grep "setup code"
SENTINEL_DOMAIN=sentinel.example.com

# --- optional: everything below overrides what the dashboard sets ---
# Ingest token(s) collectors send (default: generated, see Settings → Access).
# INGEST_TOKEN=
# An existing GitHub App instead of the one Sentinel creates for you
# (key in deploy/secrets/github-app.pem):
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# Extra people who may sign in, besides Settings → Access:
# ALLOWED_USERS=
# ALLOWED_ORG=
# DRY_RUN=true
# Investigate with Claude Code in the fixer (or choose it in Settings → AI):
# AI_PROVIDER=claude-code
# ANTHROPIC_API_KEY=
# The fixer's own Claude sign-in, used when none is set in Settings → Fixer:
# CLAUDE_CODE_OAUTH_TOKEN=
# FIXER_ANTHROPIC_API_KEY=
# Commands for every fix on top of the dashboard's list:
# FIXER_EXTRA_TOOLS=

# --- tuning (defaults shown) ---
# DOWN_AFTER=5m
# SETTLE_WINDOW=60s
# UPDATE_INTERVAL=30m
# MAX_ISSUES_PER_HOUR=10
# LOG_RETENTION=168h
# METRIC_RETENTION=168h
# GITHUB_LABELS=sentinel
